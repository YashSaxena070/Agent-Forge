# AgentForge Environment Configuration
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database
POSTGRES_PASSWORD=agentforge_dev
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge_dev@localhost:5432/agentforge

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j Graph Database
NEO4J_PASSWORD=agentforge_dev
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=agentforge
MINIO_SECRET_KEY=agentforge_dev
MINIO_BUCKET=agentforge-artifacts

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentforge-backend

# LLM Providers (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Default LLM Configuration
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4-turbo-preview
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# GitHub Integration
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# Kubernetes
KUBECONFIG=

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agentforge.local

# Slack (for notifications)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Monitoring
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION_DAYS=30

# Feature Flags
ENABLE_MCP=true
ENABLE_TEMPORAL=true
ENABLE_KAFKA=true
ENABLE_RAG=true
ENABLE_MEMORY=true

# MCP Server Configurations
MCP_GITHUB_ENABLED=true
MCP_DOCKER_ENABLED=true
MCP_KUBERNETES_ENABLED=true
MCP_FILESYSTEM_ENABLED=true
MCP_BROWSER_ENABLED=true
MCP_ISSUE_TRACKER_ENABLED=true
MCP_DOCS_ENABLED=true

# Agent Configuration
PLANNER_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=300
MAX_CONCURRENT_AGENTS=10

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# Memory Configuration
SHORT_TERM_TTL_HOURS=24
LONG_TERM_RETENTION_DAYS=365
SEMANTIC_MEMORY_MAX_ENTRIES=10000
RELATIONSHIP_MEMORY_MAX_DEPTH=3

# Deployment
DEPLOYMENT_NAMESPACE=agentforge
DEPLOYMENT_CLUSTER=local